   generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
    }
   
    datasource db {
    provider = "mysql"
    }   

    enum Rol {
        USUARIO
        ADMIN
    }

    enum Turno {
        MATUTINO
        VESPERTINO 
    }
        
    model Usuario{
        id Int @id @default(autoincrement())
        nombre String
        apellidoPaterno String
        apellidoMaterno String
        matricula Int @unique
        correo String @unique
        password String
        activo Boolean @default(true)
        fechaCreacion DateTime @default(now())
        rol Rol @default(USUARIO)
        telefono String @unique
        universidad String
        carrera String
        semestre Int
        turno Turno 

        tareas Tarea[]
        examen Examen[]
        notificacion Notificacion[]
    }

    enum Estado {
        Pendiente
        EnProceso
        Completado
    }

    enum Prioridad {
        Alta
        Media
        Baja
    }

    model Tarea {
        id Int @id @default(autoincrement())
        titulo String
        descripcion String
        materia String 
        fechaEntrega DateTime @db.Date 
        hora DateTime @db.Time(0)
        prioridad Prioridad
        estado Estado @default(Pendiente)

        usuarioId Int
        usuario Usuario @relation(fields: [usuarioId], references: [id])

        notificacion Notificacion[]

    }


    model Examen {
        id Int @id @default(autoincrement())
        titulo String
        materia String
        fecha DateTime @db.Date
        hora DateTime @db.Time(0)
        aula String
        temasEvaluar String
        usuarioId Int

        usuario Usuario @relation(fields: [usuarioId], references: [id])

        notificacion Notificacion[]
    }


    model Notificacion {
        id Int @id @default(autoincrement())
        titulo String
        mensaje String 
        leida Boolean @default(false)
        usuarioId Int 
        tareaId Int? 
        examenId Int?

        usuario Usuario @relation(fields: [usuarioId], references: [id])
        tarea Tarea? @relation(fields: [tareaId], references: [id])
        examen Examen? @relation(fields: [examenId], references: [id])
    }




